{
  "expo": {
    "name": "AudioTour",
    "slug": "audiotour",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép AudioTour sử dụng camera để quét mã QR.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      ["expo-location", {
        "locationWhenInUsePermission": "Cho phép AudioTour hiển thị vị trí và tìm đường khi bạn dùng bản đồ.",
        "isIosBackgroundLocationEnabled": false,
        "isAndroidBackgroundLocationEnabled": false,
        "isAndroidForegroundServiceEnabled": false
      }]
    ]
  }
}
