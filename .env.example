# Shared configuration
ENVIRONMENT=development

# Service ports
AUTH_SERVICE_PORT=8001
CONTENT_SERVICE_PORT=8002
NARRATION_SERVICE_PORT=8003
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://localhost:8001
CONTENT_SERVICE_URL=http://localhost:8002
NARRATION_SERVICE_URL=http://localhost:8003

# Microsoft SQL Server already running on the Windows host.
# Use localhost when running Python services directly, or host.docker.internal from Docker.
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=VinhHyAudioTourDB
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=SetYourLocalSqlServerPassword
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
# Local Windows services may use SQLSERVER_HOST=localhost and Windows auth.
# Docker must use SQL authentication and SQLSERVER_USE_WINDOWS_AUTH=false.
SQLSERVER_USE_WINDOWS_AUTH=false
JWT_SECRET=ReplaceWithAStrongSharedSecretForAuthAndContent
# Phone-accessible Gateway address. Replace YOUR_LAN_IP with this computer's
# LAN IPv4 address; localhost/127.0.0.1 on the phone refers to the phone itself.
PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:8000

# Public content/media
PUBLIC_WEB_BASE_URL=http://localhost:5173
# Must contain uploads/audio and uploads/images from the old project data.
MEDIA_ROOT=C:/xampp/htdocs/AudioTour_Seminar/services/content-service

# Content -> narration-service (local process URLs; Docker uses service DNS).
# See docs/guides/azure-narration-adapter.md. No calls while both flags are false.
ADMIN_TRANSLATION_URL=http://127.0.0.1:8003/translate
ADMIN_TTS_URL=http://127.0.0.1:8003/tts
# Internal token: set the SAME generated value as NARRATION_ADAPTER_TOKEN.
# This is NOT an Azure resource key.
ADMIN_PROVIDER_TOKEN=
ADMIN_PROVIDER_TOKEN_REQUIRED=true
# false prevents all automatic provider calls. Turning this on processes queued
# jobs for ALL enabled languages and may cost money. Do not enable as a test.
ADMIN_AUTOMATION_ENABLED=false

# narration-service -> Azure. Separate credentials from the internal token above.
# Keep false until actual provider calls and associated costs are authorized.
NARRATION_AZURE_ENABLED=false
NARRATION_ADAPTER_TOKEN=
# SQLite response/idempotency store. Preserve this directory across restarts.
NARRATION_ADAPTER_CACHE_PATH=C:/xampp/htdocs/AudioTour_Seminar/services/narration-service/data/adapter.sqlite3

AZURE_TRANSLATOR_KEY=
# Blank is valid for a global single-service Translator resource; otherwise use
# the exact region from the resource (e.g. southeastasia).
AZURE_TRANSLATOR_REGION=
# FULL Translate endpoint; custom endpoints can use a different path.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/translate

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional FULL synthesis endpoint. If blank, derived from AZURE_SPEECH_REGION:
# https://REGION.tts.speech.microsoft.com/cognitiveservices/v1
AZURE_SPEECH_ENDPOINT=
# Also supported: riff-24khz-16bit-mono-pcm, ogg-24khz-16bit-mono-opus.
AZURE_SPEECH_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
# Only configured voices/locales can be selected by incoming TTS requests.
AZURE_SPEECH_VOICES_JSON={"vi":"vi-VN-HoaiMyNeural","en":"en-US-AriaNeural","zh":"zh-CN-XiaoxiaoNeural","ko":"ko-KR-SunHiNeural","ja":"ja-JP-NanamiNeural","fr":"fr-FR-DeniseNeural"}
